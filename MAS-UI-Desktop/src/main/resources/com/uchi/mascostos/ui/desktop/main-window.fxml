<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.uchi.mascostos.ui.desktop.ui.MainWindowController"
            styleClass="main-window">

    <top>
        <HBox spacing="12.0" styleClass="window-toolbar" BorderPane.alignment="CENTER_LEFT">
            <children>
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="MASCostos" styleClass="app-title"/>
                        <Label text="Suite de costos y presupuestos de obra (estilo moderno)" styleClass="app-subtitle"/>
                    </children>
                </VBox>
                <Button text="Nuevo proyecto" fx:id="btnNuevoProyecto" styleClass="primary-button"/>
                <Button text="Actualizar" fx:id="btnActualizar" styleClass="secondary-button"/>
            </children>
            <padding>
                <Insets top="12.0" right="14.0" bottom="12.0" left="14.0"/>
            </padding>
        </HBox>
    </top>

    <left>
        <VBox spacing="10.0" prefWidth="300.0" styleClass="sidebar">
            <children>
                <Label text="Explorador de proyectos" styleClass="section-title"/>
                <TreeView fx:id="explorerTree" VBox.vgrow="ALWAYS" styleClass="explorer-tree"/>
            </children>
            <padding>
                <Insets top="12.0" right="10.0" bottom="12.0" left="10.0"/>
            </padding>
        </VBox>
    </left>

    <center>
        <VBox spacing="10.0" styleClass="workspace-wrapper">
            <children>
                <HBox spacing="8.0" styleClass="workspace-actions">
                    <children>
                        <CheckBox fx:id="chkSoloBrechas" text="Mostrar solo brechas"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Panel de control operativo" styleClass="section-title"/>
                    </children>
                </HBox>

                <HBox spacing="10.0" styleClass="kpi-row">
                    <children>
                        <VBox spacing="2.0" styleClass="kpi-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Partidas" styleClass="kpi-title"/>
                                <Label fx:id="lblTotalPartidas" text="0" styleClass="kpi-value"/>
                            </children>
                        </VBox>
                        <VBox spacing="2.0" styleClass="kpi-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Brechas catálogo" styleClass="kpi-title"/>
                                <Label fx:id="lblTotalBrechas" text="0" styleClass="kpi-value warning"/>
                            </children>
                        </VBox>
                        <VBox spacing="2.0" styleClass="kpi-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Total subpresupuesto (S/.)" styleClass="kpi-title"/>
                                <Label fx:id="lblTotalParcial" text="0.00" styleClass="kpi-value success"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <AnchorPane fx:id="sheetContainer" styleClass="panel-pane" VBox.vgrow="ALWAYS"/>
                <TabPane fx:id="detailTabs" styleClass="panel-pane detail-tabs" VBox.vgrow="ALWAYS"/>
            </children>
            <padding>
                <Insets top="12.0" right="12.0" bottom="12.0" left="0.0"/>
            </padding>
        </VBox>
    </center>

</BorderPane>
